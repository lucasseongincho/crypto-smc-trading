# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Only needed once live trading is enabled (paper trading uses the public WS feed +
# local fill simulator, no key required). Generate from Kraken account settings ->
# API, with Query Funds + Create/Cancel Orders permissions.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional - Telegram notifications for trade fills, exits, and heartbeats.
# Create a bot via @BotFather to get a token; TELEGRAM_CHAT_ID is your own chat id
# (e.g. from @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
